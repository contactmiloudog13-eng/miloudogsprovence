{
  "rules": {
    // ═══════════════════════════════════════════════════════════════════
    //  ⚠️  RÈGLE D'OR : « auth != null » N'EST PAS UNE PROTECTION.
    //  L'inscription est ouverte à tous : n'importe qui crée un compte en
    //  2 secondes et devient « auth != null ». Toute donnée client doit donc
    //  être réservée soit à l'ADMIN, soit au propriétaire de la donnée.
    //  Admin = les 2 UID ci-dessous (compte principal + secours).
    // ═══════════════════════════════════════════════════════════════════

    "carnet_requests": {
      ".read": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3')",
        ".write": "auth != null && (auth.uid === $uid || auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3')"
      }
    },

    "carnets": {
      ".read": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      "$uid": {
        ".read":  "auth != null && (auth.uid === $uid || auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3')",
        ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
        "usages": {
          "$id": {
            ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3' || (auth.uid === $uid && root.child('carnets').child($uid).child('status').val() === 'actif')"
          }
        }
      }
    },

    // Annuaire téléphone -> uid (unicité à l'inscription). Lecture par clé
    // exacte seulement : jamais la liste complète (sinon = annuaire clients).
    "phones": {
      ".read": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      "$phone": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid || auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3')",
        ".validate": "newData.isString()"
      }
    },

    // Lecture INTERDITE en bloc : seules 3 requêtes ciblées sont permises —
    // ses propres réservations (par uid, ou par email pour celles faites en
    // invité) et le décompte de SON code de parrainage. Sans ça, n'importe quel
    // inscrit téléchargeait les réservations de tous les clients.
    "reservations": {
      ".read": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3' || (auth != null && ((query.orderByChild === 'userId' && query.equalTo === auth.uid) || (query.orderByChild === 'email' && query.equalTo === auth.token.email) || (query.orderByChild === 'parrainage' && query.equalTo === root.child('users').child(auth.uid).child('codeParrain').val())))",
      ".indexOn": [
        "parrainage",
        "userId",
        "email"
      ],
      "$rid": {
        ".write": "(!data.exists() && newData.exists()) || auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3' || (auth != null && data.child('userId').val() === auth.uid)",
        ".validate": "auth != null || (newData.hasChildren(['createdAt']) && newData.child('createdAt').isNumber() && newData.hasChild('client'))"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      },
      ".indexOn": [
        "codeParrain"
      ]
    },

    // Fiches clients (nom, tél, email, adresse) : JAMAIS la liste complète.
    // Accès par clé exacte uniquement, pour le parcours de réservation.
    "clients": {
      ".read": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      "$key": {
        ".read": "auth != null",
        ".write": "auth != null || newData.exists()",
        ".validate": "auth != null || newData.hasChildren(['prenom','nom'])"
      }
    },

    "gallery_photos": {
      ".read": true,
      ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      ".indexOn": [
        "ts"
      ]
    },

    // Avis clients : un client peut DÉPOSER son avis, jamais modifier ni
    // supprimer celui d'un autre (sinon : sabotage / faux avis).
    "avis": {
      ".read": true,
      ".indexOn": [
        "reservationId",
        "ts",
        "createdAt"
      ],
      "$id": {
        ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3' || (auth != null && !data.exists() && newData.exists() && newData.child('userId').val() === auth.uid)"
      }
    },

    "google_avis": {
      ".read": true,
      ".write": "auth != null",
      ".indexOn": [
        "ts",
        "createdAt"
      ]
    },

    "newsletter": {
      ".read": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      "$id": {
        ".write": "auth != null || !data.exists()"
      }
    },

    "closures": {
      ".read": true,
      ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'"
    },
    "date_overrides": {
      ".read": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'"
    },

    "devis_history": {
      ".read":  "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'"
    },
    "client_notes": {
      ".read":  "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'"
    },
    "manual_clients": {
      ".read":  "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'"
    },
    "hidden_clients": {
      ".read":  "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'"
    },
    "hidden_resas": {
      ".read":  "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'"
    },
    "payments": {
      ".read":  "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'"
    },
    "push_subscriptions": {
      ".read":  "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      ".write": "auth != null"
    },
    "mdp_data": {
      ".read":  "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'"
    },

    "site_images": {
      ".read": true,
      ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'"
    },
    "site_config": {
      ".read": true,
      ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'"
    },

    "evasion": {
      ".read": "auth != null",
      ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      "config": {
        ".read": true
      },
      "sorties": {
        ".read": true,
        "$date": {
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "pris": {
            ".write": true,
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50 && (auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3' || !data.exists() || (newData.val() >= data.val() && newData.val() <= data.val() + 4))"
          }
        }
      },
      "inscriptions": {
        "$date": {
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$id": {
            ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3' || (!data.exists() && newData.exists())",
            ".validate": "auth != null || (newData.hasChildren(['prenom','tel','chien','createdAt']) && newData.child('createdAt').isNumber() && newData.child('prenom').isString() && newData.child('tel').isString())"
          }
        }
      },
      "attente": {
        "$date": {
          ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$id": {
            ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3' || (!data.exists() && newData.exists())",
            ".validate": "auth != null || (newData.hasChildren(['prenom','tel','createdAt']) && newData.child('createdAt').isNumber())"
          }
        }
      }
    },

    // Compteurs de fréquentation : écrits par les visiteurs (donc ouverts),
    // mais BORNÉS — sans quoi n'importe qui remet les stats à 999999.
    "analytics": {
      ".read": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      "total": {
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() >= 0 && (auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3' || !data.exists() || (newData.val() >= data.val() && newData.val() <= data.val() + 5))"
      },
      "daily": {
        "$d": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() >= 0 && $d.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && (auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3' || !data.exists() || (newData.val() >= data.val() && newData.val() <= data.val() + 5))"
        }
      },
      "dailyUnique": {
        "$d": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() >= 0 && $d.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && (auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3' || !data.exists() || (newData.val() >= data.val() && newData.val() <= data.val() + 5))"
        }
      },
      "pages": {
        "$p": {
          ".write": true,
          ".validate": "newData.isNumber() && newData.val() >= 0 && (auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3' || !data.exists() || (newData.val() >= data.val() && newData.val() <= data.val() + 5))"
        }
      },
      "j": {
        "$d": {
          ".write": true,
          ".validate": "$d.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)",
          "$k": {
            ".validate": "newData.isNumber() || newData.hasChildren()",
            "$k2": {
              ".validate": "newData.isNumber() || newData.hasChildren()",
              "$k3": {
                ".validate": "newData.isNumber()"
              }
            }
          }
        }
      }
    },

    "availability": {
      ".read": true,
      ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'"
    },

    "sejour_journal": {
      ".read":  "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'",
      "$rid": {
        ".read": "auth != null",
        ".indexOn": ["ts"]
      }
    },

    "announcements": {
      ".read": "auth != null",
      ".write": "auth.uid === 'pWy9D9chapW1dVcqHMtyvgWF2xM2' || auth.uid === '2v8MBqAKkHZqzbxxSDWI0iWmg1A3'"
    }
  }
}
